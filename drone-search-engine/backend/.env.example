# Drone Image Semantic Search Engine backend

# Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
RELOAD=true
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Upload safety
MAX_UPLOAD_SIZE_MB=25
MAX_BATCH_FILES=25
MAX_IMAGE_PIXELS=50000000
# How many images run the heavy AI pipeline at once. Keep at 1 on small instances
# (e.g. the 16 GB free tier) so concurrent uploads queue instead of exhausting RAM.
MAX_CONCURRENT_PROCESSING=1
PROCESSING_QUEUE_TIMEOUT=600
# Minimum cosine score to treat a hit as a confident match.
SEARCH_SCORE_THRESHOLD=0.18
# When nothing clears the threshold, still return this many closest matches
# (flagged above_threshold=false) instead of an empty result set.
SEARCH_FALLBACK_RESULTS=3

# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud, use the HTTPS cluster URL without :6333.
# QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key

# Access control (optional). When set, all endpoints except /health, /, /docs,
# and /images require header `Authorization: Bearer <APP_ACCESS_KEY>`. The frontend
# proxy attaches this server-side. Must match the frontend's ACCESS_PASSWORD.
# Leave unset to disable auth.
APP_ACCESS_KEY=

# Report generation (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_REPORT_MODEL=llama-3.3-70b-versatile

# Cloudinary image storage (optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=drone-search

# Model loading
USE_GPU=false
BLIP_MODEL_NAME=Salesforce/blip-image-captioning-base
YOLO_MODEL_NAME=yolov8s.pt
# Aerial imagery has small, top-down objects: a lower confidence and larger
# inference size help the stock COCO model detect anything at all.
YOLO_CONFIDENCE=0.2
YOLO_IMAGE_SIZE=1280
# Object detection backend: "sahi" tiles each image into overlapping crops so
# small overhead objects become detectable (best recall, but slower on CPU since
# each tile is a separate inference). Use "yolo" for faster whole-image detection.
DETECTION_BACKEND=sahi
SAHI_SLICE_SIZE=640
SAHI_OVERLAP_RATIO=0.2
# For aerial-specific classes, set YOLO_MODEL_NAME to VisDrone/DOTA-trained weights
# (a local path or a downloadable .pt). The pipeline picks them up with no code change.
CLIP_MODEL_NAME=ViT-L-14
CLIP_PRETRAINED=laion2b_s32b_b82k
# Only set true if you trust the YOLO checkpoint and need legacy PyTorch loading.
ALLOW_UNSAFE_YOLO_LOAD=false
