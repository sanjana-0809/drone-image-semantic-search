# Frontend deployment
#
# For hosted deployments, set this to the public URL of the deployed FastAPI backend.
# Examples:
BACKEND_URL=https://sanjana-0809-drone-semantic-search-api.hf.space
# BACKEND_URL=https://your-backend.onrender.com
# For local-only development, you can override this in .env.local:
# BACKEND_URL=http://localhost:8000

# Optional browser-direct API base. Use this only if you want the browser to call
# the backend directly instead of using the Next.js /api rewrite.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Keep this aligned with backend MAX_UPLOAD_SIZE_MB.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=25
